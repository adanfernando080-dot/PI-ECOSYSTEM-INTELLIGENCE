# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://pi:pi@localhost:5432/pi_ecosystem?schema=public

# --- Redis (optional in V1: used for rate limiting when set; in-memory fallback otherwise) ---
REDIS_URL=

# --- Auth (V1: HS256 JWT issued by a trusted server; Pi authentication will plug in later) ---
# Must be at least 32 characters. Never expose it to the frontend.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
JWT_ISSUER=pi-ecosystem-intelligence

# --- CORS: comma-separated list of allowed origins (the Lovable frontend) ---
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20

# --- Pi integration (server-side only, never sent to the frontend). Unused in V1. ---
PI_API_KEY=
PI_API_BASE_URL=https://api.minepi.com
