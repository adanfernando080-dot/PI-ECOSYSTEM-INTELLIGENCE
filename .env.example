# Pi Ecosystem Intelligence API — environment variables.
# Copy to .env for local development (`cp .env.example .env`). NEVER commit .env or any real value.
# In cloud environments, set these in the host's dashboard instead (see docs/deployment/README.md).

# --- Runtime --------------------------------------------------------------
# development | test | production. Production enables strict validation (see CORS_ORIGINS, JWT_SECRET).
NODE_ENV=development
# Local default. Cloud hosts inject their own PORT: do not set it there.
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database (REQUIRED) --------------------------------------------------
# PostgreSQL connection string. Local example below uses throw-away credentials.
# Managed PostgreSQL (e.g. Neon): use the DIRECT (non-pooled) connection string, with TLS:
#   postgresql://<user>:<password>@<host>/<database>?sslmode=require&connect_timeout=15
# Production/beta databases only ever receive `npm run db:migrate` — never db:seed, db:reset or prisma migrate reset.
# The seed/db:reset refuse any non-local database unless SEED_ALLOW_REMOTE_DATABASE names that exact host (do not set it in .env).
# The real-data tools (db:bootstrap, catalogue:import --apply) have their own variable, DB_ALLOW_REMOTE_WRITE=<exact host>, also never set in .env.
DATABASE_URL=postgresql://pi:pi@localhost:5432/pi_ecosystem?schema=public

# --- Auth (REQUIRED) ------------------------------------------------------
# HS256 signing secret, >= 32 characters, server-side only (never in the frontend).
# Generate a real one:  openssl rand -base64 48
# The placeholder below is accepted in development/test only; production refuses it.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
JWT_ISSUER=pi-ecosystem-intelligence

# --- CORS -----------------------------------------------------------------
# Comma-separated WHITELIST of allowed frontend origins (scheme + host [+ port]; no path, no trailing slash).
# development/test: optional, defaults to the local Vite server (http://localhost:5173).
# production: REQUIRED. The API refuses to start if it is missing, contains "*", or contains an origin that is
# not https, points to localhost, or is not a bare origin. Example (placeholder, replace it):
#   CORS_ORIGINS=<FRONTEND_HTTPS_ORIGIN>      e.g. https://<your-frontend-domain>
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting (optional; defaults shown) -----------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20

# --- Optional / not used by the read-only beta ----------------------------
# Redis-backed rate limiting. Leave empty: the in-memory limiter is used (fine for a single instance).
REDIS_URL=
# Pi integration: reserved, unused in V1. Server-side only, never sent to the frontend. Leave empty.
PI_API_KEY=
PI_API_BASE_URL=https://api.minepi.com
