# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://pi:pi@localhost:5432/pi_ecosystem?schema=public

# --- Redis (optional in V1: used for rate limiting when set; in-memory fallback otherwise) ---
REDIS_URL=

# --- Auth (V1: HS256 JWT issued by a trusted server; Pi authentication will plug in later) ---
# Must be at least 32 characters. Never expose it to the frontend.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
JWT_ISSUER=pi-ecosystem-intelligence

# --- CORS: comma-separated WHITELIST of allowed frontend origins (scheme + host [+ port], no path, no trailing slash) ---
# development/test: optional, defaults to the local Vite server (http://localhost:5173).
# production: REQUIRED. The API refuses to start if it is missing, contains "*", or contains an origin
# that is not https, points to localhost, or is not a bare origin. Example (placeholder, replace it):
#   CORS_ORIGINS=<FRONTEND_HTTPS_ORIGIN>      e.g. https://<your-frontend-domain>
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_WRITE_MAX=20

# --- Pi integration (server-side only, never sent to the frontend). Unused in V1. ---
PI_API_KEY=
PI_API_BASE_URL=https://api.minepi.com
